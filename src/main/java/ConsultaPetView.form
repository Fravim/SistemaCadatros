<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ConsultaPetView">
  <grid id="27dc6" binding="panel1" layout-manager="GridLayoutManager" row-count="6" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="750" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="lblSession" class="javax.swing.JLabel" binding="LblSessao">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Olá, Usuário"/>
        </properties>
      </component>
      
      <component id="btnLogoff" class="javax.swing.JButton" binding="BtnLogoff">
        <constraints>
          <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Sair / Logoff"/>
        </properties>
      </component>
      
      <component id="4121f" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Painel de Consulta de Pets"/>
        </properties>
      </component>
      
      <grid id="filtros" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="4" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="cmbFiltroTipo" class="javax.swing.JComboBox" binding="CmbFiltroTipo">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <model>
                <item value="Todos os Tipos"/>
                <item value="Cachorro"/>
                <item value="Gato"/>
              </model>
            </properties>
          </component>
          <component id="cmbFiltroSexo" class="javax.swing.JComboBox" binding="CmbFiltroSexo">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <model>
                <item value="Todos os Sexos"/>
                <item value="Macho"/>
                <item value="Fêmea"/>
              </model>
            </properties>
          </component>
          <component id="lblFiltroIdade" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Idade Máxima:"/>
            </properties>
          </component>
          <component id="spinFiltroIdade" class="javax.swing.JSpinner" binding="SpinFiltroIdade">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
      
      <scrollpane id="scroll">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="4" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="2f3f4" class="javax.swing.JTable" binding="table1" default-binding="true">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      
      <component id="lblCount" class="javax.swing.JLabel" binding="LblContador">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Total de Pets listados: 0"/>
        </properties>
      </component>
      
      <component id="e2104" class="javax.swing.JButton" binding="BtnCadastrar">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Cadastrar"/>
        </properties>
      </component>
      <component id="f2941" class="javax.swing.JButton" binding="BtnDeletar">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Deletar"/>
        </properties>
      </component>
      <component id="b9674" class="javax.swing.JButton" binding="BtnEditar">
        <constraints>
          <grid row="5" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Editar"/>
        </properties>
      </component>
    </children>
  </grid>
</form>